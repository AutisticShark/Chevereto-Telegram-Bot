# Bot Settings
BOT_MODE=POLLING
BOT_ACCESS_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_USER_IDS=123456789
BOT_ALLOWED_USER_IDS=

# Webhook Settings (if BOT_MODE=WEBHOOK)
BOT_WEBHOOK_LISTEN=0.0.0.0
BOT_WEBHOOK_PORT=8443
BOT_WEBHOOK_URL=https://yourdomain.com
BOT_WEBHOOK_SSL=false
BOT_WEBHOOK_KEY=
BOT_WEBHOOK_CERT=
BOT_WEBHOOK_SECRET_TOKEN=

# Chevereto v4 Host Settings
HOST_IMAGE_HOST=https://your-chevereto-site.com
HOST_IMAGE_HOST_API_KEY=your_chevereto_api_key_here
HOST_IMAGE_HOST_RETURN_FORMAT=json
HOST_MAX_FILE_SIZE=20
HOST_ENABLE_VIDEO=true

# Chevereto v4 Optional Upload Settings
HOST_ALBUM_ID=
HOST_CATEGORY_ID=
HOST_EXPIRATION=
HOST_NSFW=0

# Logging
DEBUG_LOGGING_LEVEL=INFO

