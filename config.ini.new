[BOT]
# Mode can be POLLING or WEBHOOK
MODE = POLLING
# Telegram Bot API token from @BotFather
ACCESS_TOKEN = 
# Telegram User IDs for Admin commands (/uptime, /storage_status, /system_status). Comma-separated.
ADMIN_USER_IDS = 
# Optional: Allowed Telegram User IDs who can upload. Leave empty to allow all users.
ALLOWED_USER_IDS = 

# Webhook configuration (only needed if MODE = WEBHOOK)
WEBHOOK_LISTEN = 0.0.0.0
WEBHOOK_PORT = 8443
WEBHOOK_URL = 
WEBHOOK_SSL = False
WEBHOOK_KEY = 
WEBHOOK_CERT = 
WEBHOOK_SECRET_TOKEN = 

[HOST]
# Chevereto v4 instance URL or domain (e.g., mysite.com or https://mysite.com)
IMAGE_HOST = 
# Chevereto API key (v4 personal user API key or system public API key)
# Find it in your account Settings > API or Dashboard > Settings > API
IMAGE_HOST_API_KEY = 
IMAGE_HOST_RETURN_FORMAT = json

# Maximum file size in MB (Telegram Bot API allows up to 20MB for bot downloads)
MAX_FILE_SIZE = 20

# Allowed file formats and MIME types
ALLOWED_FILE_FORMAT = .jpg .jpeg .png .bmp .gif .webp .avif .mp4 .webm .mov
ALLOWED_FILE_MIME = image/jpeg image/png image/bmp image/gif image/webp image/avif video/mp4 video/webm video/quicktime

# Chevereto v4 Optional Parameters:
# Target album ID (id_encoded, e.g. ZfGd). Optional default album to upload into.
ALBUM_ID = 
# Target category ID (numeric ID). Optional.
CATEGORY_ID = 
# Auto-delete expiration interval (e.g. PT5M for 5 min, P1D for 1 day, P1W for 1 week). Optional.
EXPIRATION = 
# Not Safe For Work flag (0 or 1). Default 0.
NSFW = 0
# Enable video upload support (True or False). Default True.
ENABLE_VIDEO = True

[DEBUG]
# Logging level: DEBUG, INFO, WARNING, ERROR
LOGGING_LEVEL = INFO